[Unit]
Description=Falcon labs landing page (chooser between the CCFA and CCSE labs)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m http.server 8903 --bind 127.0.0.1 --directory /srv/labs-landing
DynamicUser=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
